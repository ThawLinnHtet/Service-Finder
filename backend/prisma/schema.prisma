generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum ProviderStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CategoryChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum NrcType {
  N
  E
  P
}

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole
  city         String
  township     String
  address      String?
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  providerProfile ProviderProfile?
  refreshTokens   RefreshToken[]
  providedServices Service[] @relation("ServiceProvider")
  bookingsAsCustomer Booking[] @relation("BookingCustomer")
  bookingsAsProvider Booking[] @relation("BookingProvider")
  messages          Message[]
  reviewsGiven      Review[] @relation("ReviewCustomer")
  reviewsReceived   Review[] @relation("ReviewProvider")

  @@index([role])
  @@index([township])
  @@index([city, township])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProviderProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  about           String
  nrcStateCode    String
  nrcTownshipCode String
  nrcType         NrcType
  nrcNumber       String
  primaryCategoryId String?
  status          ProviderStatus  @default(PENDING)
  rejectionReason String?
  ratingAverage   Decimal         @default(0) @db.Decimal(3, 2)
  ratingCount     Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   ProviderDocument?
  nrcState    NrcState      @relation(fields: [nrcStateCode], references: [code], onDelete: Restrict)
  nrcTownship NrcTownship   @relation(fields: [nrcStateCode, nrcTownshipCode], references: [stateCode, code], onDelete: Restrict)
  primaryCategory Category? @relation(fields: [primaryCategoryId], references: [id], onDelete: Restrict)
  categoryChangeRequests ProviderCategoryChangeRequest[]

  @@index([status])
  @@index([nrcStateCode])
  @@index([nrcTownshipCode])
  @@index([nrcType])
  @@index([primaryCategoryId])
}

model NrcState {
  code      String        @id
  name      String
  nameMm    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  townships NrcTownship[]
  providers ProviderProfile[]

  @@unique([name])
}

model NrcTownship {
  stateCode String
  code      String
  codeMm    String
  name      String
  nameMm    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  state     NrcState          @relation(fields: [stateCode], references: [code], onDelete: Cascade)
  providers ProviderProfile[]

  @@id([stateCode, code])
  @@index([stateCode])
}

model ProviderDocument {
  id             String   @id @default(uuid())
  providerId     String   @unique
  nrcFrontUrl    String
  nrcFrontPublicId String
  nrcBackUrl     String
  nrcBackPublicId String
  selfiePhotoUrl String
  selfiePhotoPublicId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills   Skill[]
  services Service[]
  primaryProviders ProviderProfile[]
  requestedCategoryChanges ProviderCategoryChangeRequest[] @relation("RequestedCategory")
  currentCategoryChanges ProviderCategoryChangeRequest[] @relation("CurrentCategory")

  @@index([name])
}

model ProviderCategoryChangeRequest {
  id                 String                      @id @default(uuid())
  providerId         String
  currentCategoryId  String
  requestedCategoryId String
  title              String
  reason             String
  price              Decimal                     @db.Decimal(12, 2)
  experienceYears    Int
  predefinedSkillIds String[]                   @default([])
  customSkills       String[]                   @default([])
  status             CategoryChangeRequestStatus @default(PENDING)
  adminRejectionReason String?
  reviewedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  provider          ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  currentCategory   Category        @relation("CurrentCategory", fields: [currentCategoryId], references: [id], onDelete: Restrict)
  requestedCategory Category        @relation("RequestedCategory", fields: [requestedCategoryId], references: [id], onDelete: Restrict)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model Skill {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceSkills ServiceSkill[]

  @@unique([categoryId, name])
  @@index([name])
}

model Service {
  id          String          @id @default(uuid())
  providerId  String
  categoryId  String
  title       String
  description String
  price       Decimal         @db.Decimal(12, 2)
  experienceYears Int
  isActive    Boolean         @default(true)
  isVisible   Boolean         @default(false)
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  provider      User                @relation("ServiceProvider", fields: [providerId], references: [id], onDelete: Cascade)
  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  serviceSkills ServiceSkill[]
  customSkills  ServiceCustomSkill[]
  serviceAreas  ServiceArea[]
  bookings      Booking[]
  reviews       Review[]

  @@index([providerId])
  @@index([categoryId])
  @@index([price])
  @@index([isActive])
  @@index([isVisible])
  @@index([isAvailable])
  @@index([createdAt])
}

model ServiceSkill {
  id        String   @id @default(uuid())
  serviceId String
  skillId   String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([serviceId, skillId])
  @@index([skillId])
}

model ServiceCustomSkill {
  id        String   @id @default(uuid())
  serviceId String
  name      String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, name])
  @@index([name])
}

model ServiceArea {
  id        String   @id @default(uuid())
  serviceId String
  city      String
  township  String
  createdAt DateTime @default(now())

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, township])
  @@index([city, township])
}

model Booking {
  id          String        @id @default(uuid())
  serviceId   String
  customerId  String
  providerId  String
  status      BookingStatus @default(PENDING)
  note        String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User     @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  provider User     @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Cascade)
  chatRoom  ChatRoom?
  review    Review?

  @@index([serviceId])
  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
}

model ChatRoom {
  id        String   @id @default(uuid())
  bookingId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId])
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  serviceId  String
  providerId String
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider User    @relation("ReviewProvider", fields: [providerId], references: [id], onDelete: Cascade)
  customer User    @relation("ReviewCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([serviceId])
  @@index([customerId])
  @@index([rating])
}
